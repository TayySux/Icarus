<Window x:Class="Icarus.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Icarus | Input Workbench" Width="1240" Height="850" MinWidth="880" MinHeight="650" Background="#09090C" Foreground="#E8E8F0" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,20"><TextBlock Text="ICARUS" FontSize="34" FontWeight="Bold" Foreground="#22D3EE"/><TextBlock Text="INPUT WORKBENCH / DEVELOPMENT BUILD" Foreground="#A7A7BF"/><TextBlock Margin="0,12,0,0" Foreground="#FBBF24" TextWrapping="Wrap" Text="Epic prohibits Fortnite macros and warns of bans. This build is not Fortnite-certified. Preview sends no input; live output requires explicit arming."/></StackPanel>
<StackPanel Grid.Row="1"><WrapPanel><CheckBox x:Name="Armed" Content="ARM LIVE OUTPUT" Checked="ArmChanged" Unchecked="ArmChanged"/><CheckBox x:Name="FocusOnly" Content="Require profile foreground process" IsChecked="True" Checked="GuardChanged" Unchecked="GuardChanged"/></WrapPanel><WrapPanel><Button Content="Preview timeline" Click="Preview_Click"/><Button Content="Save profile" Click="Save_Click"/><Button Content="Export code" Click="Export_Click"/><Button Content="Import code" Click="Import_Click"/><Button Content="PANIC / RELEASE ALL" Background="#6B1530" Click="Panic_Click"/></WrapPanel><TextBlock Margin="0,0,0,14" TextWrapping="Wrap" Foreground="#A7A7BF" Text="Live trigger: F8 (once per press). Panic: Ctrl+Alt+End. Edit scan codes to your own binds; no game binds are assumed. Imported profiles disarm output."/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PROFILE / EDITABLE JSON" Foreground="#8B5CF6" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="Editor" FontFamily="Consolas" FontSize="14" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="EditorChanged"/></Grid><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/></Grid.RowDefinitions><TextBlock Text="EVENT TIMELINE" Foreground="#8B5CF6" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="LogBox" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="2" Text="BASE64 SHARE CODE" Margin="0,12,0,8"/><TextBox Grid.Row="3" x:Name="ShareCode" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Grid>
<Border Grid.Row="3" Margin="0,18,0,0" Padding="12" Background="#161620"><TextBlock x:Name="Status" Text="DISARMED | FPS unavailable | Ping unavailable | Controller unavailable" TextWrapping="Wrap"/></Border>
</Grid></Window>
