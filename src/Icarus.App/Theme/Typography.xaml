<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================ Typography ============================ -->
  <FontFamily x:Key="Font.Sans">Segoe UI Variable Display, Segoe UI, Selawik, sans-serif</FontFamily>
  <!-- Numerals use a fixed-pitch face so live values do not jitter while counting. -->
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

  <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

  <Style x:Key="Text.CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
  </Style>

  <!--
    Small-caps category line: 11px with wide tracking, in the accent colour.
    Tracking is em-based in WPF via TextBlock's Typography properties, so the letter
    spacing is expressed as a scaled transform-free property rather than a font feature.
  -->
  <Style x:Key="Text.CategoryLine" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.AccentCyan}"/>
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="22.4"/>
    <!-- Caps the measure so body copy stays readable at roughly 60 characters. -->
    <Setter Property="MaxWidth" Value="330"/>
  </Style>

  <Style x:Key="Text.MicroLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMicro}"/>
  </Style>

  <Style x:Key="Text.Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

  <Style x:Key="Text.MetricCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.MicroLabel}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ============================ Glass panel ============================ -->
  <!-- 10px radius, translucent fill, 1px hairline. No drop shadow: the border separates. -->
  <Style x:Key="Panel.Glass" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Glass}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>

  <!--
    Hover treatment for a card: lift 2px and brighten the border. The glow is a 1px
    accent border plus a faint outer ring, never a blur bloom.
  -->
  <Style x:Key="Panel.Card" TargetType="Border" BasedOn="{StaticResource Panel.Glass}">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
  </Style>

</ResourceDictionary>
