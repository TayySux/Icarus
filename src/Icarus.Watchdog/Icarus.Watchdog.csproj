<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The crash-proof release watchdog. A separate process so it survives the death of the
    process whose inputs it is guarding. Console rather than WinExe so it can be launched
    hidden and still write diagnostics to a log.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Icarus.Watchdog</RootNamespace>
    <AssemblyName>Icarus.Watchdog</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Icarus.Core/Icarus.Core.csproj" />
    <ProjectReference Include="../Icarus.Native/Icarus.Native.csproj" />
  </ItemGroup>

</Project>
